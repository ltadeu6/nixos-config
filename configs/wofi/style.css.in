/* Template de tema: as @chaves@ sao substituidas por home/themes.nix,
   um arquivo por tema em ~/.config/themes/<nome>/wofi-style.css.
   O ~/.config/wofi/style.css publicado apenas importa o tema atual. */
* {
    font-family: "Fira Code Nerd Font";
    font-size: 22px;
}

window {
    margin: 0px;
    border: solid 3px @teal@;
    border-radius: 10px;
    background-origin: border-box;
    background-clip: padding-box, border-box;
    padding: 0;
}

#input {
    margin: 5px;
    border: none;
    color: @text@;
    border-radius: 10px;
    background-color: @surface1@;
}

#inner-box {
    margin: 5px;
    border: none;
    border-radius: 10px;
    background-color: @surface0@;
}

#outer-box {
    margin: 5px;
    border: none;
    border-radius: 10px;
    background-color: @surface0@;
    padding: 5px;
}

#text {
    border-radius: 15px;
    margin: 5px;
    border: none;
    color: @text@;
}

#entry.activatable #text {
    color: @surface0@;
}

#entry > * {
    color: @text@;
    border-radius: 15px;
}

#entry:selected {
    border-radius: 15px;
    background-color: @surface1@;
}

#entry:selected #text {
    border-radius: 15px;
}
